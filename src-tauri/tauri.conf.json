{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Desk",
  "version": "0.23.2",
  "identifier": "io.github.shawnwu2022.ccdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC Desk",
        "width": 1024,
        "height": 640,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "shawnwu2022",
    "copyright": "Copyright © 2025 orczh; © 2026 CC Desk contributors",
    "category": "Developer Tool",
    "shortDescription": "CC Desk — Multi-project workspace for Claude Code and Codex CLI",
    "longDescription": "A multi-project, multi-session desktop workspace for Claude Code and Codex CLI, with native terminal sessions, project navigation, bounded transport, recovery, and read-only native resource projections.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer.nsh"
      }
    },
    "resources": {
      "resources/native-session-sdk/LICENSE.md": "licenses/claude-agent-sdk/LICENSE.md",
      "resources/native-session-sdk/NOTICE.txt": "licenses/claude-agent-sdk/NOTICE.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5OTA0ODkwNzQwNjVCMDYKUldRR1d3WjBrRWlRU2IrQVIxbnF2c0h2Z0tEUmd4aUl4UkhzZ2R0Lzdwc1FMVERMY3NqNzIrc3gK",
      "endpoints": [
        "https://github.com/shawnwu2022/cc-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
