{
  "build": {
    "beforeBuildCommand": "node scripts/prepare-conpty.mjs && node scripts/build-desktop-product.mjs",
    "beforeDevCommand": "node scripts/prepare-conpty.mjs && npm run dev",
    "features": [
      "remote-host"
    ]
  },
  "bundle": {
    "resources": {
      "conpty/runtime/conpty.dll": "conpty.dll",
      "conpty/runtime/OpenConsole.exe": "OpenConsole.exe",
      "conpty/runtime/LICENSE-Microsoft-ConPTY.txt": "LICENSE-Microsoft-ConPTY.txt"
    }
  }
}
